# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/hospital_superapp
# Atlas Hosted: mongodb+srv://<user>:<password>@cluster0.mongodb.net/hospital_superapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_superapp

# Authentication
# In production, must be at least 32 characters long and not use example defaults.
JWT_SECRET=replace_with_a_secure_random_32_character_secret_in_production
JWT_EXPIRES_IN=24h
ENABLE_DEV_OTP_SHORTCUT=false

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=15
RATE_LIMIT_MAX_BOOKING=30

# SMS Provider ('mock' | 'twilio' | 'aws_sns')
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI LLM Provider Configuration (Optional)
# If provided, the assistant calls live GPT-4o-mini / Gemini models with patient RAG context.
# If omitted, the assistant seamlessly runs the built-in Local Clinical Synthesizer with safety guardrails.
OPENAI_API_KEY=
GEMINI_API_KEY=
